# scaffold/.env.example — copy to .env, never commit .env
# Per AGENTS.md §2.4: no secrets in the repo. The screener runs with these unset (mock path).

# --- NEAR testnet ---
NEAR_TESTNET_ACCOUNT=
NEAR_TESTNET_RPC=https://test.rpc.near.org
# MPC signer contract id on testnet (Chain Signatures)
MPC_SIGNER_ID=v1.signer-prod.testnet

# --- Chain Signatures targets ---
# Each chain the scaffold must sign on for G2.
CHAINS_ENABLED=btc_testnet,base_sepolia,solana_devnet

# --- Read MPC (primary path for reader) ---
# H-7 pending: is the Read MPC path callable from a contract today?
READ_MPC_ENABLED=false
READ_MPC_CONTRACT=

# --- RPC quorum (fallback for reader) ---
# Three independent providers per chain. Comma-separated.
RPC_QUORUM_BTC=
RPC_QUORUM_BASE=
RPC_QUORUM_SOL=

# --- TEE worker (attest) ---
TEE_PROVIDER=none
TEE_HOST=

# --- NEAR AI Cloud (attested inference, mandate reasoning) ---
NEAR_AI_CLOUD_KEY=

# --- Intents (mainnet, dry: true quotes only, tiny amounts, dedicated account) ---
INTENTS_ACCOUNT=
INTENTS_DRY=true



# STITCH_API_KEY lives in .env (gitignored) — never in this template (AGENTS.md §2.4).
# Unset means the console is built from docs/BRAND_GUIDELINES.md tokens instead.
