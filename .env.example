# .env.example — every variable this repository reads, and nothing else.
#
# Copy to `.env` (gitignored) only if you need an override. **None of these is
# required**: `make dev`, `make demo`, `make verify`, `make test-api` and
# `make e2e` run with no .env at all. A missing variable changes a label, not
# the ability to run the demo.

# --- deployment (tools/doctor.mjs, tools/deploy-testnet.mjs) ----------------
# Set this after a deploy and `make doctor` flips the testnet row to ACTIVE.
# The console build line must be changed in `mandate/console/app.js` at the same
# time (mandate/docs/ARCHITECTURE.md §9).
MANDATE_CONTRACT=

# Account the deployer uses. Leave empty and the script generates one and asks
# the testnet faucet to create it (testnet only, no email).
MANDATE_ACCOUNT=

# Account allowed to call `settle`. Defaults to the deploying account.
MANDATE_ATTESTOR=

# yoctoNEAR attached to `create_mandate`; becomes the mandate's balance.
MANDATE_DEPOSIT=100000000

# RPC / faucet endpoints. Change these in one place, never in the source.
NEAR_RPC=https://rpc.testnet.near.org
NEAR_FAUCET=https://helper.testnet.near.org/account

# --- read API (tools/api-server.mjs, tools/keystore.mjs) -------------------
MANDATE_API_PORT=4174
MANDATE_API_HOST=127.0.0.1
MANDATE_API_RATE=120

# Where issued key hashes live. Gitignored; a fresh clone has no clients.
MANDATE_KEYS=mandate/console/data/api-keys.json

# --- data source -----------------------------------------------------------
# Everything reads this one file: the console, the API and the MCP server.
MANDATE_SNAPSHOT=mandate/console/data/snapshot.json

# --- not read yet, reserved for the attestor worker ------------------------
# The attestor is described in docs/ARCHITECTURE.md; this build runs the replay
# only, so these are placeholders and nothing here is a working credential.
# NEAR_AI_API_KEY=
# ATTESTATION_MODE=replay
